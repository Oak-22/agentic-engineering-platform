{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/provider_docs_session_start.py\" --runtime claude",
            "timeout": 20,
            "statusMessage": "Preparing local Claude Code documentation"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/instruction_manifest_hook.py\" --runtime claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/instruction_manifest_hook.py\" --runtime claude",
            "timeout": 10,
            "statusMessage": "Preparing instruction references"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/instruction_manifest_hook.py\" --runtime claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/instruction_manifest_hook.py\" --runtime claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__.*|mcp__.*atlassian.*|mcp__.*jira.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/governed_task_preflight.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking governed task isolation"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/agent_permission_gate.py\" --hook --runtime claude",
            "timeout": 10,
            "statusMessage": "Checking agent permission policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/instruction_manifest_hook.py\" --runtime claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/platform/agent-control-plane/scripts/archive_artifact_publish.py\"",
            "timeout": 10,
            "statusMessage": "Archiving published artifact"
          }
        ]
      }
    ]
  }
}
