# Personal mental-model notes, placed in whichever directory they clarify.
# Machine-local by design: they record how a maintainer holds a mechanism,
# not a repository requirement, decision, or contract.
mental-model.md

# settings.json is the shared workspace default and is tracked; everything
# else under .vscode/ is per-developer. Without this, an untracked file here
# makes the tree dirty and blocks the governed preflight and delivery cleanup.
.vscode/*
!.vscode/settings.json
