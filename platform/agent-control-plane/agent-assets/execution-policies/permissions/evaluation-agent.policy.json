{
  "schemaVersion": 2,
  "policyId": "pol_evaluation-agent",
  "principal": {
    "agentType": "evaluation-agent",
    "instanceId": null
  },
  "statements": [
    {
      "sid": "DenyPush",
      "effect": "Deny",
      "action": [
        "git:push"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "sid": "DenyGithubAndJiraMutation",
      "effect": "Deny",
      "action": [
                "github:pull_request:merge",
                "github:pull_request:create",
                "github:pull_request:update",
                "github:pull_request:review",
                "jira:issue:create",
                "jira:issue:update",
                "jira:issue:transition",
                "jira:issue:link"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "sid": "DenyBranchDelete",
      "effect": "Deny",
      "action": [
        "git:branch:delete"
      ],
      "resource": [
        "*"
      ]
    }
  ]
}
