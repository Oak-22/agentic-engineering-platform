{
  "schemaVersion": 2,
  "policyId": "pol_generalist-engineering-agent",
  "principal": {
    "agentType": "generalist-engineering-agent",
    "instanceId": null
  },
  "statements": [
    {
      "sid": "DenyUnclassifiedDestinationTools",
      "effect": "Deny",
      "action": [
        "github:tool:unclassified",
        "jira:tool:unclassified"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "sid": "AllowGovernedDeliveryGit",
      "effect": "Allow",
      "action": [
        "git:delivery:publish"
      ],
      "resource": [
        "git:agentic-engineering-platform:branch/feature/*",
        "git:agentic-engineering-platform:branch/fix/*",
        "git:agentic-engineering-platform:branch/refactor/*",
        "git:agentic-engineering-platform:branch/chore/*",
        "git:agentic-engineering-platform:branch/docs/*"
      ],
      "condition": {
        "requiresHumanApproval": false,
        "tier": 2
      }
    },
    {
      "sid": "AllowVerifiedMergedDeliveryCleanup",
      "effect": "Allow",
      "action": [
        "git:delivery:cleanup"
      ],
      "resource": [
        "git:agentic-engineering-platform:delivery/merged-pr"
      ],
      "condition": {
        "requiresHumanApproval": false,
        "tier": 2
      }
    },
    {
      "sid": "GateUnrestrictedFeatureBranchPush",
      "effect": "Allow",
      "action": [
        "git:push"
      ],
      "resource": [
        "git:agentic-engineering-platform:branch/feature/*",
        "git:agentic-engineering-platform:branch/fix/*",
        "git:agentic-engineering-platform:branch/refactor/*",
        "git:agentic-engineering-platform:branch/chore/*",
        "git:agentic-engineering-platform:branch/docs/*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 2
      }
    },
    {
      "sid": "AllowGovernedPullRequestDelivery",
      "effect": "Allow",
      "action": [
        "github:pull_request:create",
        "github:pull_request:update",
        "github:pull_request:sync",
        "github:pull_request:ready",
        "github:pull_request:copilot-review:request",
        "github:pull_request:review-thread:reply",
        "github:pull_request:review-thread:resolve"
      ],
      "resource": [
        "github:Oak-22/agentic-engineering-platform:*",
        "github:agentic-engineering-platform:*"
      ],
      "condition": {
        "requiresHumanApproval": false,
        "tier": 2
      }
    },
    {
      "sid": "DenyHumanAcceptanceActions",
      "effect": "Deny",
      "action": [
        "github:pull_request:merge",
        "github:pull_request:create-ready",
        "github:pull_request:approve",
        "github:pull_request:request-changes",
        "github:pull_request:close",
        "github:pull_request:reopen",
        "github:pull_request:retarget",
        "github:pull_request:review-thread:unresolve"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "sid": "GateHumanAuthorizedPullRequestActions",
      "effect": "Allow",
      "action": [
        "github:pull_request:reviewer:update",
        "github:pull_request:review:comment"
      ],
      "resource": [
        "github:Oak-22/agentic-engineering-platform:*",
        "github:agentic-engineering-platform:*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 2
      }
    },
    {
      "sid": "AllowGovernedAepiWorkItemMutation",
      "effect": "Allow",
      "action": [
        "jira:issue:create",
        "jira:issue:update",
        "jira:issue:transition",
        "jira:issue:link"
      ],
      "resource": [
        "jira:AEPI:issue/*",
        "jira:*:issue/AEPI-*"
      ],
      "condition": {
        "requiresHumanApproval": false,
        "tier": 2
      }
    },
    {
      "sid": "GateDirectBranchDelete",
      "effect": "Allow",
      "action": [
        "git:branch:delete"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 4
      }
    }
  ]
}
