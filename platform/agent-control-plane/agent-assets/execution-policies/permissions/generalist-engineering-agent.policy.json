{
  "schemaVersion": 2,
  "policyId": "pol_generalist-engineering-agent",
  "principal": {
    "agentType": "generalist-engineering-agent",
    "instanceId": null
  },
  "statements": [
    {
      "sid": "AllowFeatureBranchPush",
      "effect": "Allow",
      "action": [
        "git:push"
      ],
      "resource": [
        "git:agentic-engineering-platform:branch/feature/*",
        "git:agentic-engineering-platform:branch/fix/*",
        "git:agentic-engineering-platform:branch/bugfix/*",
        "git:agentic-engineering-platform:branch/hotfix/*",
        "git:agentic-engineering-platform:branch/refactor/*",
        "git:agentic-engineering-platform:branch/chore/*",
        "git:agentic-engineering-platform:branch/docs/*",
        "git:agentic-engineering-platform:branch/release/*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 3
      }
    },
    {
      "sid": "AllowPrWrite",
      "effect": "Allow",
      "action": [
        "github:pull_request:create",
        "github:pull_request:update",
        "github:pull_request:review"
      ],
      "resource": [
        "github:*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 2
      }
    },
    {
      "sid": "AllowPrMerge",
      "effect": "Allow",
      "action": [
        "github:pull_request:merge"
      ],
      "resource": [
        "github:*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 3
      }
    },
    {
      "sid": "AllowJiraMutation",
      "effect": "Allow",
      "action": [
        "jira:issue:create",
        "jira:issue:update",
        "jira:issue:transition",
        "jira:issue:link"
      ],
      "resource": [
        "jira:*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 2
      }
    },
    {
      "sid": "AllowBranchDelete",
      "effect": "Allow",
      "action": [
        "git:branch:delete"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "requiresHumanApproval": true,
        "tier": 4
      }
    }
  ]
}
