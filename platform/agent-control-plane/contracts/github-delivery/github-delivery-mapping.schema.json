{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-platform.dev/schemas/github-delivery-mapping.schema.json",
  "title": "GitHub Delivery Provider Mapping",
  "description": "Provider and operation mapping for the GitHub destination adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "destination", "canonicalAdapter", "primaryProvider", "fallbackProvider", "fallbackOrder", "providers", "operations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "destination": {"const": "github"},
    "canonicalAdapter": {"const": "adapters/github"},
    "primaryProvider": {"const": "github-mcp"},
    "fallbackProvider": {"const": "gh"},
    "fallbackOrder": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1},
      "description": "Provider keys in the order a caller tries them when an earlier surface is unavailable. The first entry is the primary provider and the last is the terminal fallback."
    },
    "providers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provider"},
      "minProperties": 2
    },
    "operations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/operation"},
      "minProperties": 1
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "transport", "auth", "enabled", "tools"],
      "allOf": [
        {
          "if": {"properties": {"auth": {"const": "runtime-specific"}}},
          "then": {"required": ["authByRuntime"]}
        }
      ],
      "properties": {
        "role": {"enum": ["primary", "optional-fallback"]},
        "transport": {"enum": ["http", "shell"]},
        "auth": {
          "enum": ["oauth", "pat", "runtime-specific"],
          "description": "Authentication mode for the provider. runtime-specific requires authByRuntime to describe each runtime adapter."
        },
        "authByRuntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude-code", "codex"],
          "properties": {
            "claude-code": {"enum": ["oauth", "pat"]},
            "codex": {"enum": ["oauth", "pat"]}
          }
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Hosted server URL. Present for http transport."
        },
        "enabled": {"type": "boolean"},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tool", "readOnly", "requiresHumanApproval"],
      "properties": {
        "provider": {"const": "github-mcp"},
        "tool": {"type": "string", "minLength": 1},
        "fallbackTool": {"type": "string", "minLength": 1},
        "readOnly": {"type": "boolean"},
        "requiresHumanApproval": {"type": "boolean"}
      }
    }
  }
}
