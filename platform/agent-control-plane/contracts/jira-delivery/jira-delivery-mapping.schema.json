{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-platform.dev/schemas/jira-delivery-mapping.schema.json",
  "title": "Jira Delivery Provider Mapping",
  "description": "Provider and operation mapping for the Jira destination adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "destination", "canonicalAdapter", "primaryProvider", "fallbackProvider", "providers", "operations"],
  "properties": {
    "schemaVersion": {"const": 2},
    "destination": {"const": "jira"},
    "canonicalAdapter": {"const": "adapters/jira"},
    "primaryProvider": {"const": "atlassian-rovo"},
    "fallbackProvider": {"const": "jira-ui"},
    "providers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provider"},
      "minProperties": 3
    },
    "operations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/operation"},
      "minProperties": 1
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "transport", "runtimeScope", "enabled", "tools"],
      "properties": {
        "role": {"enum": ["primary", "optional", "human-fallback"]},
        "transport": {"enum": ["streamable-http", "ui"]},
        "runtimeScope": {
          "enum": ["codex-default", "claude-optional", "any-human-fallback"],
          "description": "Which runtime reaches Jira through this surface. codex-default is the hosted Rovo connector; claude-optional is the direct Atlassian MCP endpoint, disabled by default for Codex; any-human-fallback is the Jira UI."
        },
        "enabled": {"type": "boolean"},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tool", "readOnly", "requiresHumanApproval", "authorizationClass"],
      "properties": {
        "provider": {"const": "atlassian-rovo"},
        "tool": {"type": "string", "minLength": 1},
        "readOnly": {"type": "boolean"},
        "requiresHumanApproval": {"type": "boolean"},
        "authorizationClass": {"const": "agent-autonomous"}
      }
    }
  }
}
