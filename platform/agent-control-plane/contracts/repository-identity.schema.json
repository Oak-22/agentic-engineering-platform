{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-platform.dev/schemas/repository-identity.schema.json",
  "title": "Machine-local Store Repository Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "readableRepositoryName",
    "repositoryId",
    "repositoryIdentityHash",
    "partitionName",
    "normalizedRemote",
    "lastObservedWorkspacePath",
    "createdAt",
    "lastObservedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "readableRepositoryName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "repositoryId": {"type": "string", "minLength": 1},
    "repositoryIdentityHash": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "partitionName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*--[0-9a-f]{24}$"},
    "normalizedRemote": {"type": ["string", "null"]},
    "lastObservedWorkspacePath": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "lastObservedAt": {"type": "string", "format": "date-time"}
  }
}
