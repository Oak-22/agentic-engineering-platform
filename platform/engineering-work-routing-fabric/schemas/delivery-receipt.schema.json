{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-platform.dev/schemas/delivery-receipt.schema.json",
  "title": "Engineering Work Delivery Receipt",
  "description": "Immutable result of applying or suppressing one routed destination action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "decisionId",
    "eventId",
    "destination",
    "idempotencyKey",
    "outcome",
    "stateChanged",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "pattern": "^receipt-[a-z0-9][a-z0-9-]*$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^decision-[a-z0-9][a-z0-9-]*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt-[a-z0-9][a-z0-9-]*$"
    },
    "destination": {
      "type": "string",
      "enum": [
        "telemetry",
        "knowledge-base",
        "jira",
        "confluence",
        "git"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "applied",
        "already-applied",
        "already-satisfied",
        "suppressed",
        "deferred",
        "rejected",
        "failed"
      ]
    },
    "stateChanged": {
      "type": "boolean"
    },
    "originalReceiptId": {
      "type": "string",
      "pattern": "^receipt-[a-z0-9][a-z0-9-]*$"
    },
    "resultRef": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "already-applied"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "originalReceiptId"
        ],
        "properties": {
          "stateChanged": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "already-satisfied",
              "suppressed",
              "deferred",
              "rejected"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "stateChanged": {
            "const": false
          }
        }
      }
    }
  ]
}
